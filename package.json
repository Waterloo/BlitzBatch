{
  "name": "blitzbatch",
  "version": "1.0.0",
  "description": "BlitzBatch - Lightning-fast bulk operation platform for CRM",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start:dev": "npm run build && npm start",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "cli": "tsx src/cli/index.ts",
    "entity:create": "tsx src/cli/index.ts entity create",
    "entity:list": "tsx src/cli/index.ts entity list"
  },
  "keywords": [
    "blitzbatch",
    "bulk-operations",
    "batch-processing",
    "crm",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bull": "^4.16.5",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "inquirer": "^12.6.0",
    "ioredis": "^5.6.1",
    "joi": "^17.13.3",
    "mongoose": "^8.14.1",
    "multer": "^1.4.5-lts.2",
    "papaparse": "^5.5.2",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bull": "^4.10.4",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/joi": "^17.2.3",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
